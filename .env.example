# Supabase 프로젝트의 공개 연결 정보. 관리자 비밀 키를 NEXT_PUBLIC_*에 넣지 않습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 가상 상품으로 입력 화면 검토. 기본은 꺼짐이며 운영에서는 활성화하지 않습니다.
ENABLE_ORDER_PREVIEW=false

# 공유 미리보기 이미지의 기준 주소. 비워두면 https://www.2180.co.kr 사용.
SITE_URL=

# 서버에서만 사용합니다. NEXT_PUBLIC_ 접두어를 붙이지 않습니다.
SUPABASE_SECRET_KEY=

# 솔라피 문자 발송. 서버 전용이며 관리자 > 문자 내역에서 켜야 실제 발송됩니다.
SMS_ENABLED=false
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=
# 선택: 외부 스케줄러의 대기 문자 처리 요청 인증값(충분히 긴 임의 문자열).
NOTIFICATION_CRON_SECRET=
