# Supabase 프로젝트의 공개 연결 정보. 관리자 비밀 키를 NEXT_PUBLIC_*에 넣지 않습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 가상 상품으로 입력 화면 검토. 기본은 꺼짐이며 운영에서는 활성화하지 않습니다.
ENABLE_ORDER_PREVIEW=false

# 공유 미리보기 이미지의 기준 주소. 비워두면 https://www.2180.co.kr 사용.
SITE_URL=

# 서버에서만 사용합니다. NEXT_PUBLIC_ 접두어를 붙이지 않습니다.
SUPABASE_SECRET_KEY=

# 주문 안내 발송. 서버 전용이며 관리자 > 알림 내역에서 연결 적용·켜기가 필요합니다.
ALIGO_ENABLED=false
# 알리고 알림톡. true는 고객에게 발송하지 않는 API 테스트 모드입니다.
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_KEY=
ALIGO_SENDER_NUMBER=
ALIGO_ORDER_TEMPLATE_CODE=UM_0746
ALIGO_SHIPPING_TEMPLATE_CODE=UM_0737
ALIGO_TEST_MODE=true
# 알리고 전용 Fixie HTTP/HTTPS 프록시. Vercel에서는 필수, 로컬에서 비우면 직접 연결.
# 인증정보가 포함된 전체 URL을 입력합니다. NEXT_PUBLIC_* 사용 금지.
FIXIE_URL=
